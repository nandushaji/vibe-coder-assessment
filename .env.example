# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role (server-only). Required for admin refund review; guest flows can use publishable key.
# Dashboard → Settings → API → copy "service_role" secret JWT (not publishable/anon).
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias:
# SUPABASE_SECRET_KEY=

# Alternative: publishable default key (anon). Safe to expose in theory, but this app only
# uses it on the server. Apply migrations (includes RLS): npm run db:link && npm run db:push
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Legacy anon JWT (if your project still shows "anon public" instead of publishable)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Admin refund review (/admin/*) — never use NEXT_PUBLIC_* for these ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random secret for signing the admin session cookie (min 16 chars). e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Optional: transactional email (Resend) — https://resend.com/api-keys
# If unset, submissions still save; refund confirmation / ops notify emails are skipped.
RESEND_API_KEY=
# Verified domain in Resend, e.g. "Acme <notifications@yourdomain.com>". Default test sender:
# GUEST_EMAIL_FROM="Guest Services <onboarding@resend.dev>"
GUEST_EMAIL_FROM=
# Optional: receive an email when a new maintenance ticket is created (internal distribution list).
MAINTENANCE_NOTIFY_EMAIL=
